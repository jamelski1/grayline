# Grayline API Credentials
# Copy this file to .env and fill in your API keys

# ACLED (https://acleddata.com/acleddatanew/wp-content/uploads/dlm_uploads/2017/10/API-User-Guide.pdf)
ACLED_API_KEY=
ACLED_EMAIL=

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# GDELT (no key required for basic access)
# GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/

# World Bank (no key required)
# WORLD_BANK_BASE_URL=https://api.worldbank.org/v2/

# OFAC (no key required for CSV downloads)
# OFAC_BASE_URL=https://www.treasury.gov/ofac/downloads/
